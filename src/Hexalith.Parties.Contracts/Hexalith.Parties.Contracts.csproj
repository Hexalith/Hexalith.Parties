<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Stable Hexalith Parties contract types for commands, events, query models, results, privacy metadata, and value objects.</Description>
    <PackageTags>parties;contracts;eventsourcing;privacy;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('..\..\..\references\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">..\..\..\references\Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('..\..\references\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">..\..\references\Hexalith.EventStore</HexalithEventStoreRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Parties.Projections" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Contracts" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <ProjectReference Include="$(HexalithMcpCliRoot)\src\Hexalith.McpCli.Abstractions\Hexalith.McpCli.Abstractions.csproj" Condition="'$(HexalithMcpCliFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.McpCli.Abstractions" Condition="'$(HexalithMcpCliFromSource)' != 'true'" />
  </ItemGroup>

</Project>
