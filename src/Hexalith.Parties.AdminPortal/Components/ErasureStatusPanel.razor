@{
    RenderFragment sectionContent = @<text>
    @if (Status is null)
    {
        <p>@Labels.GdprCertificateUnavailable</p>
    }
    else
    {
        <dl>
            <dt>@Labels.Status</dt>
            <dd>@Status.Status</dd>
            <dt>@Labels.GdprUpdatedAt</dt>
            <dd>@FormatDate(Status.UpdatedAt)</dd>
            <dt>@Labels.ErasedAt</dt>
            <dd>@FormatOptionalDate(Status.ErasedAt)</dd>
        </dl>
    }

    <section aria-labelledby="@($"erasure-report-heading-{InstanceId}")">
        <FluentText As="TextTag.H5" Size="TextSize.Size300" Weight="TextWeight.Semibold" id="@($"erasure-report-heading-{InstanceId}")">@Labels.GdprCertificate</FluentText>
        <ErasureVerificationReportPanel Status="Status" Certificate="Certificate" Labels="Labels" />
    </section>
    </text>;
}

@if (InAccordion)
{
    <FluentAccordionItem Header="@Labels.GdprErasureStatus" Expanded="true">
        @sectionContent
    </FluentAccordionItem>
}
else
{
    <section aria-labelledby="@($"erasure-status-heading-{InstanceId}")">
        <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold" id="@($"erasure-status-heading-{InstanceId}")">@Labels.GdprErasureStatus</FluentText>
        @sectionContent
    </section>
}

@code {
    /// <summary>Gets or sets whether this section belongs to the operations accordion.</summary>
    [Parameter]
    public bool InAccordion { get; set; }

    [Parameter, EditorRequired]
    public PartyErasureStatusRecord? Status { get; set; }

    [Parameter, EditorRequired]
    public ErasureCertificate? Certificate { get; set; }

    [Parameter, EditorRequired]
    public AdminPortalLabels Labels { get; set; } = new();

    [Parameter]
    public string InstanceId { get; set; } = Guid.NewGuid().ToString("N");

    private string FormatOptionalDate(DateTimeOffset? date)
        => PartyDisplayFormat.FormatDate(
            date,
            System.Globalization.CultureInfo.CurrentCulture,
            PartyDisplayFormat.CompactDateFormat,
            Labels.MissingDate);

    private string FormatDate(DateTimeOffset date)
        => date == default
            ? Labels.MissingDate
            : PartyDisplayFormat.FormatDate(
                date,
                System.Globalization.CultureInfo.CurrentCulture,
                PartyDisplayFormat.CompactDateFormat);
}
