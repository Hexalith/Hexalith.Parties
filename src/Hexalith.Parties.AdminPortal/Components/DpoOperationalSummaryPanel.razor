@{
    RenderFragment sectionContent = @<text>
    <dl>
        <dt>@Labels.GdprDpoPendingErasure</dt>
        <dd>@PartyDisplayFormat.FormatBoolean(IsErasurePending, Labels.Yes, Labels.No)</dd>
        <dt>@Labels.GdprDpoRestricted</dt>
        <dd>@PartyDisplayFormat.FormatBoolean(Party.IsRestricted, Labels.Yes, Labels.No)</dd>
        <dt>@Labels.GdprDpoConsentOverview</dt>
        <dd>@(Party.ConsentRecords?.Count ?? 0)</dd>
        <dt>@Labels.GdprDpoAuditTrail</dt>
        <dd>@ProcessingRecordCount</dd>
    </dl>
    </text>;
}

@if (InAccordion)
{
    <FluentAccordionItem Header="@Labels.GdprOperationalSummary" Expanded="true">
        @sectionContent
    </FluentAccordionItem>
}
else
{
    <section aria-labelledby="@($"dpo-summary-heading-{InstanceId}")">
        <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold" id="@($"dpo-summary-heading-{InstanceId}")">@Labels.GdprOperationalSummary</FluentText>
        @sectionContent
    </section>
}

@code {
    /// <summary>Gets or sets whether this section belongs to the operations accordion.</summary>
    [Parameter]
    public bool InAccordion { get; set; }

    [Parameter, EditorRequired]
    public PartyDetail Party { get; set; } = default!;

    [Parameter, EditorRequired]
    public AdminPortalLabels Labels { get; set; } = new();

    [Parameter]
    public string InstanceId { get; set; } = Guid.NewGuid().ToString("N");

    [Parameter]
    public bool IsErasurePending { get; set; }

    [Parameter]
    public int ProcessingRecordCount { get; set; }
}
