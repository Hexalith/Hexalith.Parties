<Project>

  <PropertyGroup>
    <!-- Only the pinned module tool supplies source roots and mode selectors.
         When this repo is consumed as a submodule, its nested Builds checkout is absent.
         Use the parent repository's root-declared catalog in that case. -->
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == '' and $([System.IO.File]::Exists('$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props'))">$(MSBuildThisFileDirectory)references/Hexalith.Builds</HexalithBuildsRoot>
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == '' and $([System.IO.File]::Exists('$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props'))">$(MSBuildThisFileDirectory)../Hexalith.Builds</HexalithBuildsRoot>
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Builds</HexalithBuildsRoot>
    <!-- The Web SDK prunes SignalR.Common in favor of Microsoft.AspNetCore.App.
         Require the fixed shared runtime for the UI as well as the central NuGet floor. -->
    <RuntimeFrameworkVersion Condition="'$(MSBuildProjectName)' == 'Hexalith.Parties.UI'">10.0.13</RuntimeFrameworkVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- In-tree pack noise from submodule generator/library packages: NU5118 fires because this
         repo's README and a submodule's own README both pack to "\" when the submodule builds
         under our Directory.Build.props chain; NU5128 is the expected "analyzer package has no
         lib/ref assemblies" warning for source-generator packages. Both are benign here (the
         submodules' standalone CI is unaffected) and would otherwise be fatal via warnings-as-errors. -->
    <NoWarn>$(NoWarn);NU5118;NU5128</NoWarn>

    <!-- NuGet Package Defaults (overridden by host/test projects) -->
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>

    <!-- NuGet Metadata -->
    <Authors>Hexalith Contributors</Authors>
    <Company>Hexalith</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Parties</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hexalith/Hexalith.Parties</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>DAPR-native party management microservice for .NET</Description>
    <PackageTags>parties;crm;dapr;eventsourcing;cqrs;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageVersion Condition="'$(HexalithPartiesPackageVersion)' != ''">$(HexalithPartiesPackageVersion)</PackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Microsoft.Extensions.Telemetry.Abstractions (pulled transitively by
       Microsoft.Extensions.Http.Resilience) ships the Microsoft.Gen.Logging source
       generator, which also processes [LoggerMessage] and collides with the in-box
       Microsoft.Extensions.Logging.Generators, emitting duplicate partial-method
       implementations (CS0757). We use only plain [LoggerMessage] (no R9 redaction /
       [LogProperties] features), so drop the telemetry generator and keep the in-box one. -->
  <Target Name="RemoveDuplicateLoggingSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.Gen.Logging'" />
    </ItemGroup>
  </Target>

</Project>
