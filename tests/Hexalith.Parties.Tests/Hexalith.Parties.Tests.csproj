<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      xUnit1051 fires when an async test calls a method that accepts CancellationToken
      without forwarding TestContext.Current.CancellationToken. Many pre-existing tests
      in this project (controller, MCP, search, projection) predate that lint rule and
      would need broad refactoring to plumb the token through every helper. Project-wide
      suppression is documented as deferred work (story 11-4 review item D5); see
      _bmad-output/implementation-artifacts/deferred-work.md.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!-- These hosts execute ASP.NET integration flows; bind restored framework authority to the runtime configuration. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.Parties\Hexalith.Parties.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Parties.Client\Hexalith.Parties.Client.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.Parties.Testing\Hexalith.Parties.Testing.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore\Hexalith.EventStore.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'">
      <Aliases>eventstore</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\Hexalith.Parties.EventStoreGateway.TestHost\Hexalith.Parties.EventStoreGateway.TestHost.csproj" Condition="'$(HexalithEventStoreFromSource)' != 'true'">
      <Aliases>eventstore</Aliases>
    </ProjectReference>
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Testing\Hexalith.EventStore.Testing.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Testing" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <ProjectReference Include="$(HexalithCommonsRoot)\src\libraries\Hexalith.Commons.ServiceDefaults\Hexalith.Commons.ServiceDefaults.csproj" Condition="'$(HexalithCommonsServiceDefaultsFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.Commons.ServiceDefaults" Condition="'$(HexalithCommonsServiceDefaultsFromSource)' != 'true'" />
    <ProjectReference Include="$(HexalithTenantsRoot)\src\Hexalith.Tenants.Client\Hexalith.Tenants.Client.csproj" Condition="'$(HexalithTenantsFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.Tenants.Client" Condition="'$(HexalithTenantsFromSource)' != 'true'" />
    <ProjectReference Include="$(HexalithTenantsRoot)\src\Hexalith.Tenants.Testing\Hexalith.Tenants.Testing.csproj" PrivateAssets="all" ExcludeAssets="analyzers" Condition="'$(HexalithTenantsFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.Tenants.Testing" PrivateAssets="all" ExcludeAssets="analyzers" Condition="'$(HexalithTenantsFromSource)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PackageTests.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/Hexalith.Parties/appsettings.json" Link="Configuration/parties-appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Live provider/owner workloads execute only in the separate integration assembly. -->
  <ItemGroup>
    <Compile Remove="Search/PartyMemoryRuntimeTests.cs" />
    <Compile Remove="Search/PartyMemoryPersistenceRuntimeTests.cs" />
    <Compile Remove="Search/PartyMemoryOwnerDependencyTests.cs" />
    <Compile Remove="Projections/PartyLegacyBackfillProcessRuntimeTests.cs" />
    <Compile Remove="Projections/PartyLegacyReadModelBackfillRuntimeTests.cs" />
    <Compile Remove="Search/PartyMemoryRuntimeIngestionObserver.cs" />
    <Compile Remove="Search/PartyMemoryRuntimeIngestionObservation.cs" />
    <Compile Remove="Search/MemoriesHealthRuntimeHandler.cs" />
    <Compile Remove="Search/MemorySearchRuntimeOptionsMonitor.cs" />
    <Compile Remove="Projections/PartyLegacyBackfillRuntimeConfiguration.cs" />
    <Compile Remove="Projections/PartyLegacyBackfillRuntimeFixture.cs" />
    <Compile Remove="Projections/PartyLegacyBackfillWorkloadManifest.cs" />
  </ItemGroup>
</Project>
