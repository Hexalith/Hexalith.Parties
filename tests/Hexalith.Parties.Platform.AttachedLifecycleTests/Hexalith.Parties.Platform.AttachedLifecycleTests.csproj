<Project DefaultTargets="Build">
  <!-- The legacy CI and Platform preparation callers still build this path. -->
  <PropertyGroup>
    <AttachedLifecycleProject>$(MSBuildThisFileDirectory)Hexalith.Parties.Platform.AttachedLifecycleQualification.Tests.csproj</AttachedLifecycleProject>
  </PropertyGroup>
  <Target Name="Restore">
    <MSBuild Projects="$(AttachedLifecycleProject)" Targets="Restore" />
  </Target>
  <Target Name="Build">
    <MSBuild Projects="$(AttachedLifecycleProject)" Targets="Build" />
  </Target>
  <Target Name="Clean">
    <MSBuild Projects="$(AttachedLifecycleProject)" Targets="Clean" />
  </Target>
  <Target Name="Rebuild">
    <MSBuild Projects="$(AttachedLifecycleProject)" Targets="Rebuild" />
  </Target>
</Project>
