+            await _custody.DidNotReceiveWithAnyArgs().CanReadAsync(default!, default!, default);
+        }
+        else
+        {
+            await _custody.Received(1).CanReadAsync(_identity, copied, Arg.Any<CancellationToken>());
+        }
+    }
