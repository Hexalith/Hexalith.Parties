+        JsonSerializer.Serialize(result).ShouldNotContain("restored-unrecognized-receipt");
+        JsonSerializer.SerializeToUtf8Bytes(restored).ShouldBe(backup);
+        if (fault is "source-expiry" or "restore" or "copies")
