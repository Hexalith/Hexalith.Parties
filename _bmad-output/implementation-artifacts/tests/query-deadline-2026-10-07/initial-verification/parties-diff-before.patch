+        }
+
+        Task result = Task.Run(() => AssertUnavailableAsync(service, historical), TestContext.Current.CancellationToken);
+        try
+        {
+            await entered.Task.WaitAsync(TimeSpan.FromSeconds(3), TestContext.Current.CancellationToken);
