[
  {
    "Name": "source-qualified-prepare",
    "Arguments": [
      "dotnet",
      "tool",
      "run",
      "hexalith-module",
      "--",
      "prepare-build",
      "--manifest",
      "module/hexalith.module-manifest.v2.json",
      "--workspace",
      "${JOB}/mapping",
      "--mode",
      "source",
      "--output",
      "json"
    ],
    "ExitCode": 0,
    "InheritsProcessEnvironment": true,
    "Environment": {},
    "CapturedOutput": "source-qualified-prepare.log.gz"
  },
  {
    "Name": "memories-source-qualified-build",
    "Arguments": [
      "dotnet",
      "build",
      "references/Hexalith.Memories/tests/Hexalith.Memories.IntegrationTests/Hexalith.Memories.IntegrationTests.csproj",
      "-c",
      "Debug",
      "-m:1",
      "--disable-build-servers",
      "-p:UseArtifactsOutput=true",
      "-p:ArtifactsPath=${JOB}/artifacts"
    ],
    "ExitCode": 0,
    "InheritsProcessEnvironment": true,
    "Environment": {
      "CustomBeforeDirectoryBuildProps": "${JOB}/mapping/source-mapping/SourceMapping.targets",
      "CustomAfterMicrosoftCommonProps": "${JOB}/mapping/source-mapping/SourceMapping.props",
      "CustomBeforeDirectoryBuildTargets": "${JOB}/mapping/source-mapping/SourceMapping.before-targets.props",
      "CustomAfterDirectoryBuildTargets": "${JOB}/mapping/source-mapping/SourceMapping.late.props",
      "AfterMicrosoftNETSdkTargets": "${JOB}/mapping/source-mapping/SourceMapping.final.targets",
      "HEXALITH_SOURCE_MAPPING_HASH": "8e4d6bcbb20f4f057717d57bdd8217975b85a9dc52b8e7ba67a14074e3060d1f",
      "Configuration": "Debug"
    },
    "CapturedOutput": "memories-source-qualified-build.log.gz"
  },
  {
    "Name": "runtime-source-qualified",
    "Arguments": [
      "dotnet",
      "${JOB}/artifacts/bin/Hexalith.Memories.IntegrationTests/debug/Hexalith.Memories.IntegrationTests.dll",
      "-class",
      "Hexalith.Memories.IntegrationTests.Ingestion.MemoryErasureProcessRestartTests",
      "-class",
      "Hexalith.Memories.IntegrationTests.Ingestion.MemoryErasureProcessProtocolTests",
      "-parallelMode",
      "none",
      "-failSkips",
      "-result-xml",
      "${RECEIPTS}/runtime-source-qualified.xml"
    ],
    "ExitCode": 0,
    "InheritsProcessEnvironment": true,
    "Environment": {
      "CustomBeforeDirectoryBuildProps": "${JOB}/mapping/source-mapping/SourceMapping.targets",
      "CustomAfterMicrosoftCommonProps": "${JOB}/mapping/source-mapping/SourceMapping.props",
      "CustomBeforeDirectoryBuildTargets": "${JOB}/mapping/source-mapping/SourceMapping.before-targets.props",
      "CustomAfterDirectoryBuildTargets": "${JOB}/mapping/source-mapping/SourceMapping.late.props",
      "AfterMicrosoftNETSdkTargets": "${JOB}/mapping/source-mapping/SourceMapping.final.targets",
      "HEXALITH_SOURCE_MAPPING_HASH": "8e4d6bcbb20f4f057717d57bdd8217975b85a9dc52b8e7ba67a14074e3060d1f",
      "Configuration": "Debug",
      "MEMORIES_ERASURE_RECEIPT_DIR": "${RECEIPTS}/runtime-source-qualified"
    },
    "CapturedOutput": "runtime-source-qualified.log.gz"
  },
  {
    "Name": "owner-algorithms-source-except-known-fixtures",
    "Arguments": [
      "dotnet",
      "${JOB}/artifacts/bin/Hexalith.Memories.IntegrationTests/debug/Hexalith.Memories.IntegrationTests.dll",
      "-class",
      "Hexalith.Memories.IntegrationTests.Ingestion.NaturalLanguageErasureIntegrationTests",
      "-class",
      "Hexalith.Memories.IntegrationTests.Ingestion.RetryWorkflowErasureIntegrationTests",
      "-method-",
      "*.UnitAndCaseDeletionPreserveForeignRawSemanticHashAtOverlappingLegacyName",
      "-method-",
      "*.MigrationRacesErasureAcrossRecreationWithoutRetainingEitherNamespace",
      "-method-",
      "*.LegacyNativeDiscoveryCoversExactUnitChunksAndBothNamespacesWhileOtherUnitsSurvive",
      "-method-",
      "*.ModernDiscoveryUsesExactOwnershipAndMissingLegacyIndexRequiresReconciliation",
      "-parallelMode",
      "none",
      "-failSkips",
      "-result-xml",
      "${RECEIPTS}/owner-algorithms-source-except-known-fixtures.xml"
    ],
    "ExitCode": 0,
    "InheritsProcessEnvironment": true,
    "Environment": {
      "CustomBeforeDirectoryBuildProps": "${JOB}/mapping/source-mapping/SourceMapping.targets",
      "CustomAfterMicrosoftCommonProps": "${JOB}/mapping/source-mapping/SourceMapping.props",
      "CustomBeforeDirectoryBuildTargets": "${JOB}/mapping/source-mapping/SourceMapping.before-targets.props",
      "CustomAfterDirectoryBuildTargets": "${JOB}/mapping/source-mapping/SourceMapping.late.props",
      "AfterMicrosoftNETSdkTargets": "${JOB}/mapping/source-mapping/SourceMapping.final.targets",
      "HEXALITH_SOURCE_MAPPING_HASH": "8e4d6bcbb20f4f057717d57bdd8217975b85a9dc52b8e7ba67a14074e3060d1f",
      "Configuration": "Debug"
    },
    "CapturedOutput": "owner-algorithms-source-except-known-fixtures.log.gz"
  }
]