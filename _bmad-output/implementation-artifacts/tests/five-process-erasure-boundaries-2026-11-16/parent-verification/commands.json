[
  {
    "Name": "prepare",
    "Arguments": [
      "dotnet",
      "tool",
      "run",
      "hexalith-module",
      "--",
      "prepare-build",
      "--manifest",
      "module/hexalith.module-manifest.v2.json",
      "--workspace",
      "${JOB}/mapping",
      "--mode",
      "source",
      "--output",
      "json"
    ],
    "Environment": {},
    "ExitCode": 0
  },
  {
    "Name": "owner-build",
    "Arguments": [
      "dotnet",
      "build",
      "references/Hexalith.Memories/tests/Hexalith.Memories.IntegrationTests/Hexalith.Memories.IntegrationTests.csproj",
