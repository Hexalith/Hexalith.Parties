<Project>
  <!-- Approved shared primitives are published in Shell/Contracts.UI 4.7.1.
       Registration remains opt-in; the package reconciler lacks registration readiness. -->
  <Target Name="ConfigureFrontComposerFeedbackCandidate" BeforeTargets="PrepareForBuild;CoreCompile">
    <PropertyGroup Condition="'$(HexalithFrontComposerFromSource)' == 'true' or '$(HexalithFrontComposerVersion)' == '4.7.1'">
      <DefineConstants>$(DefineConstants);HFC_SHARED_UI</DefineConstants>
    </PropertyGroup>
    <!-- The selected producer source supplies the corrected readiness/acceptance contract.
         Keep package orchestration local until a separately approved publication/adoption. -->
    <PropertyGroup Condition="'$(HexalithFrontComposerFromSource)' == 'true'">
      <DefineConstants>$(DefineConstants);HFC_SHARED_RECONCILE_READINESS</DefineConstants>
    </PropertyGroup>
  </Target>
  <Target Name="ConfigureMemoriesSourceCompilation" BeforeTargets="PrepareForBuild;GetAssemblyAttributes;GenerateCompileDependencyCache;CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'Hexalith.Parties' or '$(MSBuildProjectName)' == 'Hexalith.Parties.Tests'">
    <!-- Evaluate after the generated final source imports, before compile inputs and assembly metadata are captured. -->
    <PropertyGroup>
      <MemoriesSourceRefreshSupported>false</MemoriesSourceRefreshSupported>
    </PropertyGroup>
    <PropertyGroup Condition="'$(HexalithMemoriesFromSource)' == 'true'">
      <DefineConstants>$(DefineConstants);HEXALITH_MEMORIES_SOURCE_REFRESH</DefineConstants>
      <MemoriesSourceRefreshSupported>true</MemoriesSourceRefreshSupported>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="HexalithMemoriesSourceRefresh" Value="$(MemoriesSourceRefreshSupported)" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Hexalith.Parties.Tests'">
    <AssemblyMetadata Include="HexalithSourceMappingMode" Value="$(HexalithSourceMappingMode)" />
  </ItemGroup>
  <!-- Published EventStore 3.128.0 supplies recovery and generation APIs in both dependency modes. -->
  <PropertyGroup Condition="('$(MSBuildProjectName)' == 'Hexalith.Parties.Projections' or '$(MSBuildProjectName)' == 'Hexalith.Parties.Projections.Tests' or '$(MSBuildProjectName)' == 'Hexalith.Parties.Tests')">
    <DefineConstants>$(DefineConstants);HEXALITH_EVENTSTORE_NONEXPIRING_RECOVERY</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Hexalith.FrontComposer.Shell'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS9113;CS0162</WarningsNotAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Hexalith.FrontComposer.Contracts'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;CS1574</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Container image defaults (.NET SDK container support).
    Opt-in per project with:
      <EnableContainer>true</EnableContainer>
      <ContainerRepository>image-name</ContainerRepository>
    CI/CD may override ContainerRegistry via env or -p:. The image tag is not free:
    it must equal ContainerProvenanceReleaseVersion, and defaults to it when unset.
    Loaded as .targets (post-project) so EnableContainer set in the project is visible.
  -->
  <PropertyGroup Condition="'$(EnableContainer)' == 'true'">
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <ContainerBaseImage Condition="'$(ContainerBaseImage)' == ''">mcr.microsoft.com/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
    <ContainerFamily Condition="'$(ContainerFamily)' == ''">alpine</ContainerFamily>
    <ContainerRegistry Condition="'$(ContainerRegistry)' == ''">registry.hexalith.com</ContainerRegistry>
    <ContainerImageTag Condition="'$(ContainerImageTags)' == '' and '$(ContainerImageTag)' == ''">$(ContainerProvenanceReleaseVersion)</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
    <!--
      The .NET SDK 10.0.x multi-RID target serializes labels as key:value and
      reconstructs them with String.Split(':')[1] (observed on 10.0.302 and
      10.0.303). Every value containing a colon is truncated at the first one:
      URLs collapse to "https" and RFC 3339 timestamps to their date-and-hour
      prefix. These publisher-owned inputs are rebound after the SDK parse
      target below so both child configs retain the exact release identity.
    -->
    <ContainerGenerateLabelsImageSource>false</ContainerGenerateLabelsImageSource>
    <ContainerGenerateLabelsImageUrl>false</ContainerGenerateLabelsImageUrl>
    <ContainerGenerateLabelsImageDocumentation>false</ContainerGenerateLabelsImageDocumentation>
    <ContainerGenerateLabelsImageRevision>false</ContainerGenerateLabelsImageRevision>
    <ContainerGenerateLabelsImageVersion>false</ContainerGenerateLabelsImageVersion>
    <ContainerGenerateLabelsImageCreated>false</ContainerGenerateLabelsImageCreated>
    <!--
      These three URLs default from each other so a caller need only override the
      repository. ContainerProvenanceCreated deliberately has no default: it must be
      one publisher-owned instant shared by both child configs, and an MSBuild-local
      fallback is re-evaluated independently by the SDK's inner RID builds, so the
      children would disagree. The validation target below fails closed when it is
      absent; the pinned publisher supplies it.
    -->
    <ContainerProvenanceRepositoryUrl Condition="'$(ContainerProvenanceRepositoryUrl)' == ''">https://github.com/Hexalith/Hexalith.Parties</ContainerProvenanceRepositoryUrl>
    <ContainerProvenanceReleaseUrl Condition="'$(ContainerProvenanceReleaseUrl)' == ''">$(ContainerProvenanceRepositoryUrl)/releases/tag/v$(ContainerProvenanceReleaseVersion)</ContainerProvenanceReleaseUrl>
    <ContainerProvenanceDocumentationUrl Condition="'$(ContainerProvenanceDocumentationUrl)' == ''">$(ContainerProvenanceRepositoryUrl)/blob/$(ContainerProvenanceSourceSha)/README.md</ContainerProvenanceDocumentationUrl>
    <!-- Shared by every ContainerProvenance*Url validation below so the three checks cannot drift. -->
    <_ContainerProvenanceHttpsUrlPattern>\Ahttps://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\s]*)?\z</_ContainerProvenanceHttpsUrlPattern>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableContainer)' == 'true'">
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="$(ContainerProvenanceRepositoryUrl)" />
    <ContainerLabel Include="org.opencontainers.image.url" Value="$(ContainerProvenanceReleaseUrl)" />
    <ContainerLabel Include="org.opencontainers.image.documentation" Value="$(ContainerProvenanceDocumentationUrl)" />
    <ContainerLabel Include="org.opencontainers.image.revision" Value="$(ContainerProvenanceSourceSha)" />
    <ContainerLabel Include="org.opencontainers.image.version" Value="$(ContainerProvenanceReleaseVersion)" />
    <ContainerLabel Include="org.opencontainers.image.created" Value="$(ContainerProvenanceCreated)" />
    <ContainerLabel Include="org.opencontainers.artifact.created" Value="$(ContainerProvenanceCreated)" />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="MIT" />
    <ContainerLabel Include="org.opencontainers.image.vendor" Value="Hexalith" />
  </ItemGroup>

  <Target Name="ValidateContainerProvenanceInputs"
          BeforeTargets="_PublishMultiArchContainers;_PublishSingleContainer"
          Condition="'$(EnableContainer)' == 'true'">
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceSourceSha)', '^[0-9a-f]{40}$')) != 'true'"
           Text="ContainerProvenanceSourceSha must be an exact lowercase 40-character commit SHA." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceReleaseVersion)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.((0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$')) != 'true'"
           Text="ContainerProvenanceReleaseVersion must be SemVer without build metadata or leading-zero numeric identifiers." />
    <Error Condition="'$(ContainerImageTag)' != '' and '$(ContainerImageTag)' != '$(ContainerProvenanceReleaseVersion)'"
           Text="ContainerImageTag must equal ContainerProvenanceReleaseVersion." />
    <Error Condition="'$(ContainerImageTags)' != '' and '$(ContainerImageTags)' != '$(ContainerProvenanceReleaseVersion)'"
           Text="ContainerImageTags must be exactly ContainerProvenanceReleaseVersion and nothing else." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceCreated)', '\A(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z\z')) != 'true'"
           Text="ContainerProvenanceCreated must be an exact UTC RFC 3339 second." />
    <PropertyGroup>
      <_ContainerProvenanceDaysInMonth>$([System.DateTime]::DaysInMonth($([System.Int32]::Parse($(ContainerProvenanceCreated.Substring(0, 4)))), $([System.Int32]::Parse($(ContainerProvenanceCreated.Substring(5, 2))))))</_ContainerProvenanceDaysInMonth>
    </PropertyGroup>
    <Error Condition="$([System.Int32]::Parse($(ContainerProvenanceCreated.Substring(8, 2)))) &gt; $(_ContainerProvenanceDaysInMonth)"
           Text="ContainerProvenanceCreated must contain a real calendar date." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceRepositoryUrl)', '$(_ContainerProvenanceHttpsUrlPattern)')) != 'true'"
           Text="ContainerProvenanceRepositoryUrl must be a well-formed https URL." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceReleaseUrl)', '$(_ContainerProvenanceHttpsUrlPattern)')) != 'true'"
           Text="ContainerProvenanceReleaseUrl must be a well-formed https URL." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ContainerProvenanceDocumentationUrl)', '$(_ContainerProvenanceHttpsUrlPattern)')) != 'true'"
           Text="ContainerProvenanceDocumentationUrl must be a well-formed https URL." />
  </Target>

  <!-- Correct the SDK multi-RID key:value reconstruction before the child image is created. -->
  <Target Name="RebindContainerProvenanceLabels"
          AfterTargets="_ParseItemsForPublishingSingleContainer"
          Condition="'$(EnableContainer)' == 'true' and '$(_IsSingleRIDBuild)' == 'true'">
    <ItemGroup>
      <ContainerLabel Remove="org.opencontainers.image.source;org.opencontainers.image.url;org.opencontainers.image.documentation;org.opencontainers.image.revision;org.opencontainers.image.version;org.opencontainers.image.created;org.opencontainers.artifact.created" />
      <ContainerLabel Include="org.opencontainers.image.source" Value="$(ContainerProvenanceRepositoryUrl)" />
      <ContainerLabel Include="org.opencontainers.image.url" Value="$(ContainerProvenanceReleaseUrl)" />
      <ContainerLabel Include="org.opencontainers.image.documentation" Value="$(ContainerProvenanceDocumentationUrl)" />
      <ContainerLabel Include="org.opencontainers.image.revision" Value="$(ContainerProvenanceSourceSha)" />
      <ContainerLabel Include="org.opencontainers.image.version" Value="$(ContainerProvenanceReleaseVersion)" />
      <ContainerLabel Include="org.opencontainers.image.created" Value="$(ContainerProvenanceCreated)" />
      <ContainerLabel Include="org.opencontainers.artifact.created" Value="$(ContainerProvenanceCreated)" />
    </ItemGroup>
  </Target>
</Project>
