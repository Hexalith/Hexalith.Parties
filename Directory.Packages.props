<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Keep an alternate caller catalog authoritative; the normal catalog still uses the qualified product default. -->
    <_PartiesDefaultBuildPackageProps Condition="'$(HexalithBuildsRoot)' != ''">$(HexalithBuildsRoot)/Props/Directory.Packages.props</_PartiesDefaultBuildPackageProps>
    <_PartiesDefaultBuildPackageProps Condition="'$(HexalithBuildsRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</_PartiesDefaultBuildPackageProps>
    <_PartiesCallerCatalogNormalized Condition="'$(Hexalith1BuildPackageProps)' != ''">$([MSBuild]::NormalizePath('$(Hexalith1BuildPackageProps)'))</_PartiesCallerCatalogNormalized>
    <_PartiesDefaultCatalogNormalized>$([MSBuild]::NormalizePath('$(_PartiesDefaultBuildPackageProps)'))</_PartiesDefaultCatalogNormalized>
    <_PartiesUsesDefaultCatalog>false</_PartiesUsesDefaultCatalog>
    <_PartiesUsesDefaultCatalog Condition="'$(Hexalith2BuildPackageProps)' == '' and '$(Hexalith3BuildPackageProps)' == '' and ('$(Hexalith1BuildPackageProps)' == '' or '$(_PartiesCallerCatalogNormalized)' == '$(_PartiesDefaultCatalogNormalized)')">true</_PartiesUsesDefaultCatalog>
    <!-- Define paths of the Hexalith packages props. -->
    <Hexalith1BuildPackageProps Condition="'$(HexalithBuildsRoot)' != ''">$(HexalithBuildsRoot)/Props/Directory.Packages.props</Hexalith1BuildPackageProps>
    <Hexalith1BuildPackageProps Condition="'$(HexalithBuildsRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</Hexalith1BuildPackageProps>
    <Hexalith2BuildPackageProps>$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props</Hexalith2BuildPackageProps>
    <Hexalith3BuildPackageProps>$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/Directory.Packages.props</Hexalith3BuildPackageProps>
    <!-- Standalone family fallbacks defer to an existing caller-selected catalog. -->
    <!-- Keep the signed Platform v2.2.5 owner versions when the default catalog is
         a newer module-tool import. Explicit caller properties and a distinct caller
         catalog still win; an imported default catalog that assigns unconditionally
         still overwrites these values. -->
    <HexalithCommonsVersion Condition="'$(HexalithCommonsVersion)' == '' and '$(_PartiesUsesDefaultCatalog)' == 'true' and '$(HexalithSourceMappingMode)' != 'package'">3.0.4</HexalithCommonsVersion>
    <HexalithEventStoreVersion Condition="'$(HexalithEventStoreVersion)' == '' and '$(_PartiesUsesDefaultCatalog)' == 'true'">5.4.0</HexalithEventStoreVersion>
    <HexalithTenantsVersion Condition="'$(HexalithTenantsVersion)' == '' and '$(_PartiesUsesDefaultCatalog)' == 'true'">8.0.2</HexalithTenantsVersion>
    <HexalithFrontComposerVersion Condition="'$(HexalithFrontComposerVersion)' == '' and '$(_PartiesUsesDefaultCatalog)' == 'true'">6.0.1</HexalithFrontComposerVersion>
    <HexalithMemoriesVersion Condition="'$(HexalithMemoriesVersion)' == '' and '$(_PartiesUsesDefaultCatalog)' == 'true'">4.1.0</HexalithMemoriesVersion>
  </PropertyGroup>
  <!-- Import the required Hexalith.Packages.props file. -->
  <Import Project="$(Hexalith1BuildPackageProps)" Condition="Exists('$(Hexalith1BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith2BuildPackageProps)" Condition="Exists('$(Hexalith2BuildPackageProps)') And '$(HexalithVersionsLoaded)' != 'true'" />
  <Import Project="$(Hexalith3BuildPackageProps)" Condition="'$(HexalithVersionsLoaded)' != 'true'" />
  <!-- Match the dependency floors of the default Commons.ServiceDefaults 3.0.4. -->
  <ItemGroup Condition="'$(_PartiesUsesDefaultCatalog)' == 'true' and '$(HexalithSourceMappingMode)' != 'package'">
    <PackageVersion Update="Microsoft.Extensions.Http.Resilience;Microsoft.Extensions.ServiceDiscovery">
      <Version Condition="'%(PackageVersion.Version)' == '11.0.0'">11.0.1</Version>
    </PackageVersion>
  </ItemGroup>
  <PropertyGroup Condition="'$(HexalithSourceMappingMode)' != 'package'">
    <HexalithAspireAppHostSdkVersion>17.0.0</HexalithAspireAppHostSdkVersion>
    <HexalithAspireHostingDaprVersion>17.0.0-preview.1.261120-0454</HexalithAspireHostingDaprVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Orchestration.linux-x64" Version="$(HexalithAspireAppHostSdkVersion)" Condition="'@(PackageVersion->WithMetadataValue('Identity', 'Aspire.Hosting.Orchestration.linux-x64'))' == ''" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.linux-x64" Version="$(HexalithAspireAppHostSdkVersion)" Condition="'@(PackageVersion->WithMetadataValue('Identity', 'Aspire.Dashboard.Sdk.linux-x64'))' == ''" />
  </ItemGroup>
  <ItemGroup Condition="'$(HexalithSourceMappingMode)' != 'package'">
    <PackageVersion Update="Aspire.Azure.Messaging.ServiceBus" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Security.KeyVault" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Storage.Blobs" Version="17.0.0" />
    <PackageVersion Update="Aspire.Azure.Storage.Queues" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Azure.CosmosDB" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Docker" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
    <PackageVersion Update="Aspire.Hosting.Kubernetes" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Redis" Version="17.0.0" />
    <PackageVersion Update="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Update="Aspire.Microsoft.Azure.Cosmos" Version="17.0.0" />
    <PackageVersion Update="CommunityToolkit.Aspire.Hosting.Dapr" Version="17.0.0-preview.1.261120-0454" />
  </ItemGroup>
</Project>
